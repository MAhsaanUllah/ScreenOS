# Copy to .env and add your private API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider order. Add comma-separated backups, for example: deepseek,gemini
# Never share the API key in chat or commit .env.
LLM_PROVIDER=deepseek,gemini

# Configurable timeouts in seconds (defaults: LLM_TIMEOUT=120, OLLAMA_TIMEOUT=300)
# LLM_TIMEOUT=120
# OLLAMA_TIMEOUT=300

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama local base URL (default: http://localhost:11434/v1, or inside Docker: http://host.docker.internal:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# BYOK encryption at rest (cloud). Set a strong random value; all org keys are
# encrypted with it. Local dev auto-generates data/.cred_key if unset.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCREENOS_CRED_KEY=

# Cloud host allowlist (comma-separated). Default: 127.0.0.1,localhost
# Example: SCREENOS_ALLOWED_HOSTS=app.example.com,api.example.com
# SCREENOS_ALLOWED_HOSTS=

# Postgres for VPS (optional): set DATABASE_URL=postgresql://user:pass@host/db
# Requires: pip install psycopg[binary]
# DATABASE_URL=
