# Copy to .env and add your private API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider order. Add comma-separated backups, for example: deepseek,gemini
# Never share the API key in chat or commit .env.
LLM_PROVIDER=deepseek,gemini
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://api.commandcode.ai/provider/v1/chat/completions

DEEPSEEK_API_KEY=

DEEPSEEK_MODEL=deepseek-v4-flash
